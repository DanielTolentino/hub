---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import CardNoBody from "../components/CardNoBody.astro";
import WeatherCard from "../components/WeatherCard.jsx";
---

<Layout title="MyHub">
  <main>
    <h1>Bem-vindo ao meu <span class="text-gradient">Hub</span></h1>
    <WeatherCard />
    <p class="description">
      Dedicado a organizar todos os meus links e acessos aos meus servidores.
      <br />
      <a href="https://github.com/DanielTolentino" target="_blank"
        >👨‍💻 GitHub Profile</a
      >
       &nbsp;
      <a href="https://github.com/DanielTolentino/hub" target="_blank"
        >📦 Source code</a
      >
    </p>
    <ul role="list" class="link-card-grid">
      <Card
        href="https://reader.danieltolentino.net/"
        icon="rss"
        title="Miniflux"
        body="Agregador de RSS. Self Hosted"
      />
      <Card
        href="https://blog.danieltolentino.net/"
        title="Blog"
        icon="globe"
        body="Blog onde escrevo sobre tecnologia e descobertas."
      />
      <CardNoBody
        href="https://danieltolentino.net/transfer"
        title="🔗 Enviar arquivos via link"
      />
      <CardNoBody
        href="https://danieltolentino.net/sendp"
        title="🔐 Enviar senhas"
      />
      <CardNoBody
        href="https://danieltolentino.net/markdown"
        title="📃 Markdown Cheatsheet"
      />
      <CardNoBody
        href="https://danieltolentino.net/pomodoro"
        title="🍅 Pomodoro"
      />
      <CardNoBody
        href="https://danieltolentino.net/yt"
        title="📹 Individious"
      />
      <Card
        href="https://danieltolentino.net/projects/"
        title="Projetos"
        icon="portifa"
        body="Meus projetos"
      />
    </ul>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 2rem 1.5rem;
    max-width: 70ch;
    width: 100%;
  }
  
  h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200%;
    background-position: 0%;
    animation: gradient-shift 8s ease infinite;
  }
  
  @keyframes gradient-shift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  
  .description {
    line-height: 1.7;
    margin: 1.5rem 0 2rem 0;
    border: 1px solid rgba(var(--accent), 15%);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
  }
  
  .description:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: rgba(var(--accent), 25%);
  }
  
  .description a {
    color: rgb(var(--accent));
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
    border-bottom: 2px solid transparent;
  }
  
  .description a:hover {
    border-bottom-color: rgb(var(--accent));
  }
  
  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
    padding: 0;
    margin-top: 2rem;
  }
  
  @media (min-width: 640px) {
    main {
      padding: 3rem 2rem;
    }
    
    .link-card-grid {
      gap: 1.5rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    .description {
      background: rgba(0, 0, 0, 0.6);
      color: white;
      border-color: rgba(var(--accent), 30%);
      backdrop-filter: blur(10px);
    }
    
    h1 {
      color: white;
    }
  }
</style>
